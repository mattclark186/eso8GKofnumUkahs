   "source": [
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "def x_y_split(data):\n",
    "    x = data.drop(columns=['Y'])\n",
    "    y = data['Y']\n",
    "    return x, y\n",
    "\n",
    "def tt_split(x, y):\n",
    "    return train_test_split(\n",
    "        x, y, test_size=0.2, stratify=y, random_state=29\n",
    "    )"
   ]
